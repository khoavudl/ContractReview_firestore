{
  "name": "backend",
  "version": "1.0.0",
  "description": "Contract Review v2.0 - Firebase Cloud Functions v2 Serverless Backend",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run --exclude 'src/rules/**'",
    "test:watch": "vitest --exclude 'src/rules/**'",
    "test:rules": "vitest run --fileParallelism=false src/rules/firestore.rules.test.ts src/rules/storage.rules.test.ts",
    "test:all": "vitest run",
    "seed": "tsx scripts/seedWhitelistUsers.ts"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "private": true
}
