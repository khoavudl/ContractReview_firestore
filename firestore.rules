rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{userId}
    // Document ID: Firebase Auth UID
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - email: string (required) - User email
    //   - displayName: string (required) - Full display name
    //   - role: string (required, 'USER' | 'LEGAL' | 'HOL') - System role
    //   - department: string (optional) - Department name
    //   - isActive: bool (required) - Account activation status
    //   - createdAt: timestamp (required) - Creation timestamp
    //   - updatedAt: timestamp (required) - Last update timestamp
    //
    // Collection: /contracts/{contractId}
    // Document ID: CTR-YYMM-XXXX
    // Fields:
    //   - contractId: string (required) - Primary key
    //   - title: string (required) - Contract title
    //   - supplier: string (required) - Supplier / Partner name
    //   - description: string (required) - Summary description
    //   - status: string (required) - 'DRAFT' | 'PENDING_LEGAL' | 'LEGAL_COMMENTED' |
    //                                 'USER_REVISING' | 'LEGAL_APPROVED' | 'PENDING_HOL' |
    //                                 'HOL_COMMENTED' | 'HOL_APPROVED' | 'COMPLETED'
    //   - currentVersion: int (required) - Version index (>= 1)
    //   - createdBy: map (required) - { uid: string, email: string, displayName: string }
    //   - rejectCount: int (required) - Number of revisions requested
    //   - isArchived: bool (required) - Archive flag
    //   - companyRole: string (required, 'BUYER' | 'SELLER') - Company contract position
    //   - currentVersionFile: map (required) - { versionNo, originalFileName, storagePath, previewPdfPath }
    //   - approvedFile: map (optional) - { storagePath, approvedAt }
    //   - createdAt: timestamp (required) - Creation timestamp
    //   - updatedAt: timestamp (required) - Last update timestamp
    //
    // Subcollections under /contracts/{contractId}:
    //   - /versions/{versionId}: Immutable contract revisions (.docx & preview PDF paths)
    //   - /tasks/{taskId}: Review tasks table (Legal recommendations & User notes)
    //   - /comments/{commentId}: Immutable discussion comments & feedback
    //   - /ai_analyses/{analysisId}: Immutable AI analysis documents (Summary, Risk, Decision)
    //   - /reference_files/{fileId}: Reference documents attached to contract
    //   - /activities/{activityId}: Immutable audit trail entries
    //
    // Collection: /notifications/{userId}/items/{notifId}
    // Document ID: Notification UUID
    // Fields:
    //   - notifId: string (required) - Notification ID
    //   - contractId: string (required) - Related contract ID
    //   - title: string (required) - Notification title
    //   - message: string (required) - Notification body message
    //   - type: string (required) - 'STATUS_CHANGE' | 'NEW_COMMENT' | 'TASK_ASSIGNED'
    //   - isRead: bool (required) - Read status
    //   - createdAt: timestamp (required) - Creation timestamp
    //
    // Collection: /counters/{counterId}
    // Document ID: Period key (e.g. contracts_2609)
    // Fields:
    //   - lastSeq: int (required) - Monotonically increasing sequence number
    //   - period: string (required) - Period key e.g. '2609'
    //   - updatedAt: timestamp (optional) - Last update timestamp
    //
    // ===============================================================

    // ══════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS — Hybrid RBAC (Claims + Firestore Doc Fallback)
    // ══════════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    // Email (lowercase) từ token — whitelist doc được key theo email
    function hasEmailClaim() {
      return ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0;
    }

    // Lấy thông tin user document từ Firestore (/users/{lowercaseEmail})
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data;
    }

    // Kiểm tra user document (keyed by email) có tồn tại hay không
    function hasUserDoc() {
      return hasEmailClaim()
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()));
    }

    // Kiểm tra user đã được whitelist VÀ đang active
    // Hỗ trợ Hybrid RBAC:
    // a) Ưu tiên Custom Claims trên JWT token (0 read cost)
    // b) Fallback sang Firestore doc /users/{userId} nếu Custom Claims chưa đồng bộ
    function isWhitelisted() {
      return isAuthenticated() && (
        (
          ('role' in request.auth.token)
          && request.auth.token.role != null
          && ('isActive' in request.auth.token)
          && request.auth.token.isActive == true
        ) || (
          hasUserDoc()
          && ('isActive' in getUserDoc())
          && getUserDoc().isActive == true
        )
      );
    }

    // Lấy vai trò (role) của người dùng:
    // Trả về Custom Claim role nếu có, ngược lại fallback sang Firestore doc an toàn
    function getRole() {
      return (('role' in request.auth.token) && request.auth.token.role != null)
        ? request.auth.token.role
        : (hasUserDoc() && ('role' in getUserDoc()) ? getUserDoc().role : 'USER');
    }

    function isUser() {
      return isWhitelisted() && getRole() == 'USER';
    }

    function isLegal() {
      return isWhitelisted() && getRole() == 'LEGAL';
    }

    function isHOL() {
      return isWhitelisted() && getRole() == 'HOL';
    }

    function isStaff() {
      return isLegal() || isHOL();
    }

    // Đọc document contract cha — CHỈ dùng trong subcollection rules (tốn 1 read)
    function getContract(contractId) {
      return get(/databases/$(database)/documents/contracts/$(contractId)).data;
    }

    function ownsContract(contractId) {
      return getContract(contractId).createdBy.uid == request.auth.uid;
    }

    // Kiểm tra tính hợp lệ của luồng chuyển đổi trạng thái State Machine theo RBAC
    function isValidTransition(fromStatus, toStatus, role, isOwner) {
      return (
        // USER (bắt buộc isOwner):
        // - DRAFT -> PENDING_LEGAL
        // - USER_REVISING / LEGAL_COMMENTED / HOL_COMMENTED -> PENDING_LEGAL
        // - HOL_APPROVED -> COMPLETED
        (role == 'USER' && isOwner && (
          (fromStatus == 'DRAFT' && toStatus == 'PENDING_LEGAL') ||
          (fromStatus in ['USER_REVISING', 'LEGAL_COMMENTED', 'HOL_COMMENTED'] && toStatus == 'PENDING_LEGAL') ||
          (fromStatus == 'HOL_APPROVED' && toStatus == 'COMPLETED')
        )) ||
        // LEGAL:
        // - PENDING_LEGAL -> USER_REVISING (Request Change)
        // - PENDING_LEGAL -> PENDING_HOL (Submit Head)
        (role == 'LEGAL' && fromStatus == 'PENDING_LEGAL' && (
          toStatus in ['USER_REVISING', 'PENDING_HOL']
        )) ||
        // HOL:
        // - PENDING_HOL -> USER_REVISING (Request Change)
        // - PENDING_HOL -> HOL_APPROVED (Approve)
        (role == 'HOL' && fromStatus == 'PENDING_HOL' && (
          toStatus in ['USER_REVISING', 'HOL_APPROVED']
        ))
      );
    }

    // ══════════════════════════════════════════════════════════════
    // COLLECTION: /users/{userId} — Whitelist Người dùng
    // ══════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isWhitelisted() || (
        isAuthenticated() && hasEmailClaim() && userId == request.auth.token.email.lower()
      );
      allow write: if false;           // Chỉ nhập qua Admin SDK / Firebase Console
    }

    // ══════════════════════════════════════════════════════════════
    // COLLECTION: /contracts/{contractId} — Hồ sơ Hợp đồng
    // ══════════════════════════════════════════════════════════════
    match /contracts/{contractId} {
      // ─── READ: Data Isolation ───
      // USER chỉ đọc hợp đồng do chính mình tạo; Staff đọc toàn bộ hồ sơ
      allow read: if isWhitelisted() && (
        isStaff() || (
          ('createdBy' in resource.data)
          && ('uid' in resource.data.createdBy)
          && resource.data.createdBy.uid == request.auth.uid
        )
      );

      // ─── CREATE: Chỉ USER, status = DRAFT, createdBy = chính mình ───
      allow create: if isUser()
        && ('status' in request.resource.data)
        && request.resource.data.status == 'DRAFT'
        && ('createdBy' in request.resource.data)
        && ('uid' in request.resource.data.createdBy)
        && request.resource.data.createdBy.uid == request.auth.uid;

      // ─── UPDATE: Cho phép 2 trường hợp: ───
      // • Trường hợp A (Metadata updates thông thường):
      //   status không đổi (request.resource.data.status == resource.data.status)
      //   và tuân theo các điều kiện phân quyền role hiện có.
      // • Trường hợp B (Status State Transition trực tiếp):
      //   status thay đổi (request.resource.data.status != resource.data.status)
      //   thỏa mãn ma trận isValidTransition(...)
      //   và bảo vệ tính bất biến của createdBy.uid và contractId.
      allow update: if isWhitelisted()
        && ('status' in request.resource.data)
        && ('status' in resource.data)
        && ('createdBy' in request.resource.data)
        && ('createdBy' in resource.data)
        && ('uid' in request.resource.data.createdBy)
        && ('uid' in resource.data.createdBy)
        && request.resource.data.createdBy.uid == resource.data.createdBy.uid
        && (
          // Trường hợp A: Metadata updates thông thường (status không đổi)
          (
            request.resource.data.status == resource.data.status && (
              // USER: sửa metadata DRAFT hoặc upload bản sửa khi USER_REVISING
              (isUser()
                && resource.data.createdBy.uid == request.auth.uid
                && resource.data.status in ['DRAFT', 'USER_REVISING']) ||
              // LEGAL: sửa data khi đang review hoặc đã gửi comment
              (isLegal()
                && resource.data.status in ['PENDING_LEGAL', 'LEGAL_COMMENTED']) ||
              // HOL: sửa data khi đang review hoặc đã gửi comment
              (isHOL()
                && resource.data.status in ['PENDING_HOL', 'HOL_COMMENTED'])
            )
          ) ||
          // Trường hợp B: Status State Transition (status thay đổi)
          (
            request.resource.data.status != resource.data.status
            && ('contractId' in request.resource.data)
            && ('contractId' in resource.data)
            && request.resource.data.contractId == resource.data.contractId
            && isValidTransition(
              resource.data.status,
              request.resource.data.status,
              getRole(),
              resource.data.createdBy.uid == request.auth.uid
            )
          )
        );

      // ─── DELETE: Chỉ User tạo, chỉ khi còn DRAFT ───
      allow delete: if isUser()
        && ('createdBy' in resource.data)
        && ('uid' in resource.data.createdBy)
        && resource.data.createdBy.uid == request.auth.uid
        && ('status' in resource.data)
        && resource.data.status == 'DRAFT';

      // ════════════════════════════════════════════════════════════
      // SUBCOLLECTIONS RULES TRỰC THUỘC /contracts/{contractId}
      // ════════════════════════════════════════════════════════════

      // ─── Versions: Phiên bản văn bản (.docx, preview PDF) ───
      match /versions/{versionId} {
        allow read: if isWhitelisted() && (isStaff() || ownsContract(contractId));
        allow create: if isWhitelisted();
        allow update: if isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fileName', 'isApprovedVersion']);
        allow delete: if false;
      }

      // ─── Tasks: Bảng Nhiệm vụ Rà soát ───
      match /tasks/{taskId} {
        allow read:   if isWhitelisted() && (isStaff() || ownsContract(contractId));
        allow create: if isStaff();        // Chỉ Legal/HOL tạo task
        allow update: if isWhitelisted()   // User giải trình/notes, Legal cập nhật quyết định
                      && (isStaff() || ownsContract(contractId));
        allow delete: if isStaff();        // Chỉ Legal/HOL xóa task
      }

      // ─── Comments: Bình luận Trao đổi (Immutable) ───
      match /comments/{commentId} {
        allow read: if isWhitelisted() && (isStaff() || ownsContract(contractId));
        allow create: if isWhitelisted()
                      && ('author' in request.resource.data)
                      && ('uid' in request.resource.data.author)
                      && request.resource.data.author.uid == request.auth.uid;
        allow update, delete: if false;    // Comments là immutable
      }

      // ─── AI Analyses: Kết quả Phân tích Gemini (Immutable) ───
      match /ai_analyses/{analysisId} {
        allow read: if isWhitelisted() && (isStaff() || ownsContract(contractId));
        allow create: if isWhitelisted();
        allow update, delete: if false;
      }

      // ─── Reference Files: Tài liệu Tham chiếu Đính kèm ───
      match /reference_files/{fileId} {
        allow read: if isWhitelisted() && (isStaff() || ownsContract(contractId));
        allow create: if isWhitelisted();
        allow delete: if isWhitelisted()
                      && resource.data.uploadedBy.uid == request.auth.uid;
        allow update: if false;
      }

      // ─── Activities: Nhật ký Kiểm toán - Audit Trail (Immutable) ───
      match /activities/{activityId} {
        allow read: if isWhitelisted() && (isStaff() || ownsContract(contractId));
        allow create: if isWhitelisted();
        allow update, delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════
    // COLLECTION: /notifications/{userId}/items/{notifId} — Thông báo
    // ══════════════════════════════════════════════════════════════
    match /notifications/{userId}/items/{notifId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isWhitelisted()
        && ('contractId' in request.resource.data)
        && request.resource.data.contractId is string;
    }

    // ══════════════════════════════════════════════════════════════
    // COLLECTION: /counters/{counterId} — Distributed Atomic Counter
    // ══════════════════════════════════════════════════════════════
    match /counters/{counterId} {
      allow read: if isWhitelisted();
      allow create: if isUser()
        && ('lastSeq' in request.resource.data)
        && request.resource.data.lastSeq == 1
        && ('period' in request.resource.data)
        && request.resource.data.period is string;
      allow update: if isUser()
        && ('lastSeq' in request.resource.data)
        && request.resource.data.lastSeq is int
        && ('lastSeq' in resource.data)
        && resource.data.lastSeq is int
        && request.resource.data.lastSeq == resource.data.lastSeq + 1
        && ('period' in request.resource.data)
        && request.resource.data.period is string
        && (!('period' in resource.data) || request.resource.data.period == resource.data.period);
      allow delete: if false;
    }
  }
}
